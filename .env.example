# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Where the SQLite database lives (any SQLAlchemy URL works).
ROSEHILL_DATABASE_URL=sqlite:///data/rosehill.db

# Which lot source to use: "demo" (generated sample data) until the real
# site adapter lands.
ROSEHILL_SOURCE=demo

# Auction site to scrape.
ROSEHILL_SOURCE_BASE_URL=https://rosehillonline.ca

# Timezone used to display closing times.
ROSEHILL_TIMEZONE=America/Toronto

# Minimum seconds between requests to the auction site (must be >= 1).
ROSEHILL_REQUEST_INTERVAL_SECONDS=2.0

# User-Agent sent with every request.
ROSEHILL_USER_AGENT=rosehill-auction-manager/0.1 (personal use)

# How often the scheduler wakes up to check what needs scraping (>= 30).
ROSEHILL_SCHEDULER_TICK_SECONDS=60

# Full sweep of every active lot, in minutes (>= 10).
ROSEHILL_FULL_SWEEP_MINUTES=60

# Lots closing within SOON_WITHIN minutes are re-checked every SOON_EVERY minutes,
# and lots closing within IMMINENT_WITHIN minutes every IMMINENT_EVERY minutes.
ROSEHILL_SOON_WITHIN_MINUTES=120
ROSEHILL_SOON_EVERY_MINUTES=5
ROSEHILL_IMMINENT_WITHIN_MINUTES=15
ROSEHILL_IMMINENT_EVERY_MINUTES=1

# A lot that disappears from the listings this many minutes after its closing time
# is recorded as closed at its last seen bid.
ROSEHILL_CLOSE_GRACE_MINUTES=5

# First-run fee defaults, used until you save real rates on the Settings page.
# Rosehill's buyer's premium is not confirmed yet; check their terms. 13% is Ontario HST.
ROSEHILL_DEFAULT_PREMIUM_PERCENT=15
ROSEHILL_DEFAULT_TAX_PERCENT=13
